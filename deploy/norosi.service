[Unit]
Description=norosi Discord Bot (24/7 Background Service)
After=network.target

[Service]
Type=simple
User=kami
WorkingDirectory=/home/kami/Desktop/norosi
EnvironmentFile=-/home/kami/Desktop/norosi/.env
ExecStart=/home/kami/Desktop/norosi/venv/bin/python3 /home/kami/Desktop/norosi/bot.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target


